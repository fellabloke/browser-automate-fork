# ─── Agent First IDE — Environment Configuration ─────────
# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#

AGENT_MODE=free

# ─── Cloudflare Workers AI ───────────────────────────────
# Create a Workers AI API token with Workers AI read/run access. Both the
# account ID and token are required. Blank values make this provider a no-op.
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional comma/semicolon-delimited tokens. Tokens on one account share quota.
CLOUDFLARE_API_TOKENS=
# Blank uses https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
CLOUDFLARE_BASE_URL=
CLOUDFLARE_TEXT_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_MAX_TOKENS=2048
# The vision model requires one-time acceptance of Meta's license; see README.
CLOUDFLARE_VISION_ENABLED=true
CLOUDFLARE_VISION_MODELS=@cf/meta/llama-3.2-11b-vision-instruct

# ─── Free Text Providers ─────────────────────────────────
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEYS=
NVIDIA_TEXT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-120b

# Auxiliary calls consume much more volume than worker action decisions.
AUXILIARY_PROVIDER_ORDER=google,cloudflare,nvidia

# ─── OpenAI / LLM Provider ───────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
# Optional comma/semicolon-delimited extra keys used automatically on provider failures.
OPENAI_API_KEY_FALLBACKS=

# ─── Google LLM Provider (Gemma / Gemini) ────────────────
# Use this for Gemma models on Google AI APIs.
GOOGLE_API_KEY=
GOOGLE_API_KEY_FALLBACKS=
# Backward compatibility alias (optional if GOOGLE_API_KEY is set)
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACKS=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
WORKER_MODEL_ORDER=google:gemini-3.5-flash-lite,nvidia:nemotron-3.5-lightning-30b-a3b,cloudflare:llama-3.3-70b-instruct-fp8-fast,nvidia:gpt-oss-120b

# ─── Worker Vision-Language Model ─────────────────────────
# Optional. Falls back to OPENAI_API_KEY if not set.
WORKER_VLM_API_KEY=
WORKER_VLM_API_KEY_FALLBACKS=
WORKER_VLM_MODEL=gemini-3.5-flash
VISION_MODEL_TIMEOUT_SECONDS=20
VISION_FAILOVER_BUDGET_SECONDS=60
VISION_MAX_ATTEMPTS=2
TEXT_WORKER_MAX_ATTEMPTS=2
CAPTCHA_MAX_ATTEMPTS=2
AUXILIARY_MAX_ATTEMPTS=1
CAPTCHA_MAX_REFRESHES=3
VISION_PROVIDER_TIMEOUT_BURST=1
MAX_VISION_CONSULTS=12
VISION_MAX_TOKENS=1000
WORKER_VLM_FALLBACK_MODEL=gemini-2.5-flash
# Called only for a detected survey audio/video question.
SURVEY_AUDIO_ENABLED=true
SURVEY_AUDIO_MODEL=gemini-3.5-flash
# Keep selecting and completing surveys until the process is stopped. An objective
# containing "one survey only" or "complete exactly one survey" overrides this.
SURVEY_CONTINUOUS_MODE=true
# LangGraph transition ceiling for continuous sessions (not an action/API budget).
CONTINUOUS_GRAPH_RECURSION_LIMIT=1000000
# Bound prompt/state/checkpoint growth during long continuous sessions.
AGENT_HISTORY_MAX_ENTRIES=48
AGENT_HISTORY_RECENT_ACTIONS=8
SURVEY_ANSWER_LEDGER_MAX=32
AGENT_HISTORY_PROMPT_MAX_CHARS=9000
SURVEY_CYCLE_ARCHIVE_MAX=160
SURVEY_CYCLE_MEMORY_MAX_CHARS=7000
SURVEY_PROFILE_RECENT_ANSWERS=50
SURVEY_PROFILE_RELEVANT_ANSWERS=20
SURVEY_PROFILE_RECENT_PREFERENCES=60
SURVEY_PROFILE_RELEVANT_PREFERENCES=20
SURVEY_PROFILE_PROMPT_MAX_CHARS=24000
SURVEY_PROFILE_SANITIZE_AFTER_WRITES=12
SURVEY_PROFILE_SANITIZE_INTERVAL_HOURS=6
CHECKPOINT_RETENTION_ENABLED=true
CHECKPOINT_KEEP_ACTIVE=80
CHECKPOINT_KEEP_PRIOR_THREADS=12
CHECKPOINT_KEEP_PER_PRIOR_THREAD=2
CHECKPOINT_PRUNE_EVERY_NODES=40
# Optional low-token selector model used in executor stage-B.
DOM_SELECTOR_MODEL=gemini-2.5-flash

# ─── Supervisor LLM ──────────────────────────────────────
SUPERVISOR_MODEL_API_KEY=
SUPERVISOR_MODEL_API_KEY_FALLBACKS=
SUPERVISOR_LLM_MODEL=gemma-4-27b-it
SUPERVISOR_FALLBACK_MODEL=gpt-4.1-mini

# ─── Browser Runtime ─────────────────────────────────────
# Canonical Windows + WSL flow (Start-Agent.ps1 also sets these explicitly).
# Clear LOCAL_CDP_ENDPOINT to use the local Playwright/Xvfb fallback on Linux.
BROWSER_MODE=LOCAL_CDP
BROWSER_HEADLESS=false
LOCAL_CDP_ENDPOINT=http://127.0.0.1:9222

# ─── Survey Respondent Profile ────────────────────────────
# Defaults to persistence/survey_profiles.json (git-ignored because it may hold
# personal facts). The selected profile remains fixed across model failovers.
# Durable profile growth is off by default. Enabling it requires both this flag
# and learning.auto_expand=true in the JSON; only the fixed identity allowlist
# can then be stored. Survey opinions and one-off answers remain cycle-local.
SURVEY_PROFILE_AUTO_EXPAND_ENABLED=false
SURVEY_PROFILE_PATH=
SURVEY_PROFILE_NAME=default

# ─── Human-Like Action Pacing ───────────────────────────
HUMAN_ACTION_DELAY_MIN_SECONDS=1.4
HUMAN_ACTION_DELAY_MAX_SECONDS=3.2

# ─── Survey Provider Loading ────────────────────────────
# Ordered provider loop. Qmee is attempted first. If no verified survey answer
# is committed within 25 successful action steps, the next URL is tried.
SURVEY_PROVIDER_URLS=https://www.qmee.com/en-gb/surveys,https://www.surveystreak.com/?page=dashboard
# Destinations that must be closed immediately after a click/tab handoff.
SURVEY_BLACKLISTED_URLS=https://welcome.eu.walr.com
SURVEY_PROVIDER_ENTRY_STEP_LIMIT=25
# Also cap timeout-heavy dashboard/login attempts by elapsed time.
SURVEY_PROVIDER_ENTRY_TIMEOUT_SECONDS=60
# Rotate/refresh when offer-card navigation remains on the dashboard this long.
SURVEY_DASHBOARD_STALL_STEPS=4
SURVEY_DASHBOARD_STALL_TIMEOUT_SECONDS=30
# Permit effectively tied offers so transient Qmee element IDs/rounding cannot
# hold the dashboard while still rejecting materially worse value.
SURVEY_OFFER_EFFICIENCY_TOLERANCE_PERCENT=5
# Abandon only after this many seconds with the same canonical route, question,
# and meaningful form state. Volatile query-token changes do not reset it.
SURVEY_STUCK_TIMEOUT_SECONDS=180
# Long budget for true redirects/hydration; ordinary same-page actions use the
# sub-second settle budget and return as soon as useful browser state is stable.
SURVEY_LOAD_TIMEOUT_MS=30000
SURVEY_LOAD_WAIT_MS=8000
SURVEY_SAME_PAGE_SETTLE_MS=500
SURVEY_READINESS_POLL_MS=100
# Clicks return on the first verified effect; replay-safe navigation may use
# the remaining bounded settle window.
CLICK_FAST_SETTLE_MS=120
CLICK_SETTLE_MAX_MS=600
# Survey decisions get a much smaller per-call and total failover tax.
SURVEY_WORKER_MODEL_TIMEOUT_SECONDS=15
SURVEY_WORKER_FAILOVER_BUDGET_SECONDS=45
SURVEY_MODEL_TIMEOUT_COOLDOWN_SECONDS=60
# The survey transition ledger replaces per-step goal-model audits. Sample one
# only every N verified question transitions.
SURVEY_PRM_AUDIT_TRANSITIONS=25
# Exact-page recipes require two verified successes and retire below 90%.
SURVEY_RECIPE_MEMORY_ENABLED=true
SURVEY_RECIPE_DB=persistence/survey_recipes.db

# ─── Agent Safety ─────────────────────────────────────────
DRY_RUN_MODE=true
AUTONOMOUS_CONTINUATION=true
MAX_CYCLES=15
WORKER_CONFIDENCE_THRESHOLD=0.4
PERSISTENT_THREAD_ID=reddit-main-session
WORKER_LLM_MIN_GAP_SECONDS=2.0
SUPERVISOR_LLM_MIN_GAP_SECONDS=2.5

# ─── Free-tier usage and failover budgets ────────────────
# Broad consensus, LLM reality reconciliation and WebDreamer multiply calls.
# Keep them off for routine browsing; irreversible actions still force the
# separate safety consensus path.
CLARITY_CONSENSUS_ENABLED=0
REALITY_LLM_ENABLED=0
WEBDREAMER_ENABLED=0
PRM_AUDIT_EVERY=4
WEB_DREAMER_NUM_CANDIDATES=1
WEB_DREAMER_NUM_SIMULATIONS=1
WEB_DREAMER_TIMEOUT_SECONDS=20
MODEL_TIMEOUT_FLOOR_SECONDS=5
# Hard wall-clock and attempt limits for each model failover walk.
MODEL_FAILOVER_BUDGET_SECONDS=15
MODEL_FAILOVER_MAX_ATTEMPTS=5
MODEL_PROVIDER_TIMEOUT_BURST=3
# Persistently park a model/key after repeated timeouts; backoff doubles to the cap.
MODEL_TIMEOUT_RETRY_COOLDOWN_SECONDS=60
MODEL_TIMEOUT_RETRY_COOLDOWN_MAX_SECONDS=60
MODEL_UNRELIABLE_RETRY_SECONDS=60
MODEL_PROBE_TIMEOUT_SECONDS=15
MODEL_VISION_PROBE_TIMEOUT_SECONDS=25
# Finite preference weights let a proven fast fallback outrank a failing primary.
MODEL_ROLE_PRIORITY_PENALTY_SECONDS=6
MODEL_TIER_PENALTY_SECONDS=5
# Anonymous per-key health and local quota estimates survive restarts.
MODEL_HEALTH_PERSISTENCE=true
MODEL_HEALTH_PATH=persistence/model_health.json
# Copy the limits shown for this Gemini model in AI Studio. Leave zero if
# unknown. Each configured Gemini key is assumed to be a separate project.
GEMINI_PROJECT_RPM_LIMIT=0
GEMINI_PROJECT_TPM_LIMIT=0
GEMINI_PROJECT_RPD_LIMIT=0
# Optional different limits per project, ordered exactly like the key list.
# Blank list entries inherit the shared value above.
GEMINI_PROJECT_RPM_LIMITS=
GEMINI_PROJECT_TPM_LIMITS=
GEMINI_PROJECT_RPD_LIMITS=
# Stop locally at this percentage rather than discovering the hard limit.
GEMINI_USAGE_SOFT_LIMIT_PERCENT=90
# Preserve 20% of configured Gemini capacity for critical worker decisions;
# workers may use that reserve while retaining a 2% hard-limit margin.
GEMINI_AUXILIARY_USAGE_LIMIT_PERCENT=80
GEMINI_WORKER_USAGE_LIMIT_PERCENT=98
# Browser actions need short structured replies. This also prevents providers
# from reserving an unnecessarily large completion against free-tier TPM.
TEXT_MODEL_MAX_TOKENS=1000
# Per-section survey prompt ceilings. The full current page is already present
# in the handoff, so it is not duplicated in the worker prompt.
SURVEY_WORKER_HANDOFF_MAX_CHARS=3000
SURVEY_WORKER_CYCLE_MEMORY_MAX_CHARS=1000
SURVEY_WORKER_HISTORY_MAX_CHARS=1200
SURVEY_WORKER_DOM_MAX_CHARS=5000
SURVEY_WORKER_PROFILE_MAX_CHARS=3000
SURVEY_WORKER_PROMPT_MAX_CHARS=8000
SURVEY_WORKER_SYSTEM_PROMPT_MAX_CHARS=8000
CONSENSUS_VOTER_TIMEOUT_SECONDS=12
# Reuse an identical recent screenshot result for non-CAPTCHA ambiguity only.
VISION_CACHE_TTL_SECONDS=30

# ─── LangSmith Tracing ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-first-ide
LANGCHAIN_ENDPOINT=
