# ─── Agent First IDE — Environment Configuration ─────────
AGENT_MODE=free

# ─── Groq Configuration (Primary Worker & Primary Vision) ───
# For fallbacks, add a comma and your second key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GROQ_VISION_API_KEY=
GROQ_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ─── NVIDIA NIM Configuration (Secondary Worker & Secondary Vision) ───
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEYS=
NVIDIA_TEXT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

NVIDIA_VISION_API_KEY=
NVIDIA_VISION_MODELS=meta/llama-3.2-11b-vision-instruct

# ─── Cerebras Configuration (Tertiary Worker) ─────────────
# Add a comma and a second key for fallback.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# ─── Google Gemini Configuration (Fallback & Supervisor) ───
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACKS=
GEMINI_TEXT_MODEL=gemma-4-31b-it

# ─── Optional Internal Aliases ────────────────────────────
WORKER_VLM_MODEL=gemini-3.5-flash
WORKER_VLM_FALLBACK_MODEL=gemini-2.5-flash
DOM_SELECTOR_MODEL=gemini-2.5-flash
SUPERVISOR_LLM_MODEL=gemma-4-27b-it
SUPERVISOR_FALLBACK_MODEL=gpt-4.1-mini

# ─── Browser Runtime ─────────────────────────────────────
BROWSER_MODE=LOCAL_CDP
BROWSER_HEADLESS=false
LOCAL_CDP_ENDPOINT=http://localhost:9222
LOCAL_BROWSER_AUTOSTART=false
LOCAL_BROWSER_STARTUP_TIMEOUT_SECONDS=18
LOCAL_BROWSER_FALLBACK_TO_ISOLATED=false
FORCE_VISIBLE_LOCAL_BROWSER=true

# ─── Human-Like Action Pacing ───────────────────────────
HUMAN_ACTION_DELAY_MIN_SECONDS=1.4
HUMAN_ACTION_DELAY_MAX_SECONDS=3.2

# ─── Agent Safety ─────────────────────────────────────────
DRY_RUN_MODE=true
AUTONOMOUS_CONTINUATION=true
MAX_CYCLES=15
WORKER_CONFIDENCE_THRESHOLD=0.4
PERSISTENT_THREAD_ID=reddit-main-session
WORKER_LLM_MIN_GAP_SECONDS=2.0
SUPERVISOR_LLM_MIN_GAP_SECONDS=2.5
